# =============================================================================
# AnimalSetu Cloud Functions — Environment Variables
# =============================================================================
#
# Copy this file to .env in this directory for local development:
#   cp .env.example .env
#
# Or use the shared template at: backend/.env.example
#
# NEVER commit .env or service account JSON files to git.
# =============================================================================

# Application
APP_ENV=development
APP_NAME=AnimalSetu
API_VERSION=v1

# Firebase Admin SDK (required)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
STORAGE_BUCKET=

# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Google Cloud
GOOGLE_CLOUD_PROJECT=

# AI (Phase 3)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Maps / Places (Phase 3)
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=

# CORS — comma-separated allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate limiting
RATE_LIMIT_AI_PER_MINUTE=10
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_UPLOAD_PER_MINUTE=10
RATE_LIMIT_AI_HEALTH_HOURLY=20
RATE_LIMIT_AI_DIET_HOURLY=5
RATE_LIMIT_AI_EXERCISE_HOURLY=5
RATE_LIMIT_AI_BREED_HOURLY=10
RATE_LIMIT_PLACES_HOURLY=60

# Logging (debug | info | warn | error)
LOG_LEVEL=info
