# =============================================================================
# AnimalSetu Backend — Environment Variables
# =============================================================================
#
# SETUP:
#   1. Copy this file to .env in the same directory:
#        cp .env.example .env
#   2. Fill in your values (especially Firebase credentials)
#   3. NEVER commit .env or service account JSON files to git
#
# For local emulator development, you can also copy to:
#   backend/functions/.env
#
# Production: use Firebase Secret Manager / Cloud Functions env config
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=development
APP_NAME=AnimalSetu
API_VERSION=v1

# -----------------------------------------------------------------------------
# Firebase Admin SDK (required)
# Get from: Firebase Console → Project Settings → Service Accounts
#           → Generate new private key
# -----------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the full private key; keep \n for line breaks inside quotes:
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=
STORAGE_BUCKET=

# Alternative to FIREBASE_CLIENT_EMAIL + FIREBASE_PRIVATE_KEY above:
# Point to a downloaded service account JSON file instead.
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# -----------------------------------------------------------------------------
# Google Cloud
# -----------------------------------------------------------------------------
GOOGLE_CLOUD_PROJECT=

# -----------------------------------------------------------------------------
# AI — Phase 5+
# Gemini API key from Google AI Studio / Google Cloud
# -----------------------------------------------------------------------------
GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# Maps & Places — Phase 6+
# Server-side keys only; never expose to frontend
# -----------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=

# -----------------------------------------------------------------------------
# CORS
# Comma-separated list of allowed frontend origins
# Do NOT use * in production
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# -----------------------------------------------------------------------------
# Rate limiting (requests per minute per user/IP)
# -----------------------------------------------------------------------------
RATE_LIMIT_AI_PER_MINUTE=10
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_UPLOAD_PER_MINUTE=10

# -----------------------------------------------------------------------------
# Logging
# Options: debug | info | warn | error
# -----------------------------------------------------------------------------
LOG_LEVEL=info
