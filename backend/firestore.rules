rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(ownerId) {
      return isSignedIn() && request.auth.uid == ownerId;
    }

    match /users/{userId} {
      allow read, update: if isOwner(userId);
      allow create: if isOwner(userId);
      allow delete: if false;
    }

    match /pets/{petId} {
      allow read: if isOwner(resource.data.ownerId);
      allow create: if isOwner(request.resource.data.ownerId)
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if isOwner(resource.data.ownerId)
        && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if false;
    }

    match /pets/{petId}/{document=**} {
      allow read, write: if isSignedIn()
        && get(/databases/$(database)/documents/pets/$(petId)).data.ownerId == request.auth.uid;
    }

    match /reminders/{reminderId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow update, delete: if isOwner(resource.data.userId);
    }

    match /documents/{documentId} {
      allow read, write: if isOwner(resource.data.ownerId);
      allow create: if isOwner(request.resource.data.ownerId);
    }

    match /aiConversations/{conversationId} {
      allow read, update, delete: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
    }

    match /aiConversations/{conversationId}/{document=**} {
      allow read, write: if isSignedIn()
        && get(/databases/$(database)/documents/aiConversations/$(conversationId)).data.userId == request.auth.uid;
    }

    match /emergencies/{emergencyId} {
      allow read, update: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow delete: if false;
    }

    match /auditLogs/{logId} {
      allow read, write: if false; // Server-side admin only
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
